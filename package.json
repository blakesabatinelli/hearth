{
  "name": "hearth",
  "version": "0.0.1",
  "private": true,
  "description": "Hearth - installable home management system built on OpenClaw + Bonsai 27B + GLiNER2",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r --filter='./packages/*' --filter='./apps/*' test",
    "test:unit": "pnpm -r --filter='./packages/*' --filter='./apps/*' --if-present run test:unit",
    "test:integration": "pnpm -r --filter='./packages/ha-adapter' --filter='./apps/control' --if-present run test:integration",
    "integration": "pnpm -r --filter='./packages/ha-adapter' --filter='./apps/control' --if-present run test:integration",
    "doctor": "node packages/cli/dist/cli.js doctor",
    "verify:lock": "node scripts/verify-bonsai-lock.mjs && node scripts/verify-gliner2-lock.mjs",
    "verify:portability": "node scripts/verify-portability.mjs",
    "start": "node apps/control/dist/src/main.js",
    "upgrade": "node scripts/upgrade.mjs"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.10.5",
    "vitest": "2.1.9"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}